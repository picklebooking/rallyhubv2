// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// SHARED MODELS (No tenantId - shared across all tenants)
// ============================================================================

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  isPlatformAdmin Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  tenantMembers  TenantMember[]
  courtBookings  CourtBooking[]
  courtSchedules CourtSchedule[]
  openPlaySeats  OpenPlaySeat[]

  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ============================================================================
// TENANT ROOT MODEL
// ============================================================================

model Tenant {
  id              String       @id @default(uuid())
  name            String
  status          TenantStatus @default(PENDING)
  tenantOwnerName String?

  // Contact (business-level, not tied to any one physical location)
  phone String?
  email String?

  // Branding (brand-wide default)
  primaryColor String? // Hex color for theming

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members TenantMember[]
  venues  Venue[]

  @@index([status])
}

enum TenantStatus {
  PENDING // Awaiting first venue to finish setup
  ACTIVE // At least one venue is live
  SUSPENDED // Temporarily disabled (billing, ToS)
  INACTIVE // Permanently closed
}

// ============================================================================
// VENUE MODEL (a physical location, owned by exactly one Tenant)
// ============================================================================

model Venue {
  id       String      @id @default(uuid())
  tenantId String
  name     String // "Downtown", "Westside" - distinguishes venues under one tenant
  slug     String      @unique // For subdomain (e.g., "cebu-club")
  status   VenueStatus @default(PENDING)

  // Location
  address  String?
  city     String?
  state    String?
  zipCode  String?
  country  String  @default("PH")
  timezone String  @default("Asia/Manila")

  // Contact
  phone   String?
  email   String?
  website String?

  // Branding
  logo        String? // URL to logo image
  coverImage  String? // URL to cover/hero image
  description String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courts          Court[]
  bookingSettings VenueBookingSettings?

  @@index([tenantId])
  @@index([slug])
  @@index([status])
}

enum VenueStatus {
  PENDING // Awaiting setup completion
  ACTIVE // Live and bookable
  SUSPENDED // Temporarily disabled
  INACTIVE // Permanently closed
}

enum BookingStartAlignment {
  HOUR
  HALF_HOUR
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model VenueBookingSettings {
  id               String                @id @default(uuid())
  venueId          String                @unique
  minDurationHours Int
  maxDurationHours Int
  horizonDays      Int
  startAlignment   BookingStartAlignment
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  venue            Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  openingHours     VenueOpeningHours[]
}

model VenueOpeningHours {
  id             String               @id @default(uuid())
  settingsId     String
  weekday        Weekday
  opensAtMinute  Int
  closesAtMinute Int
  settings       VenueBookingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
}

// ============================================================================
// TENANT-SCOPED MODELS (Venue and TenantMember carry tenantId; Court,
// CourtBooking, and CourtSchedule belong to a Venue and reach their tenant
// through it)
// ============================================================================

model TenantMember {
  id        String     @id @default(uuid())
  userId    String
  tenantId  String
  venueId   String? // null = tenant-wide (OWNER or STAFF); set = one venue (STAFF)
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isActive  Boolean    @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, venueId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, role])
}

enum TenantRole {
  OWNER // Full access: settings, billing, courts, bookings
  STAFF // manages venues and courts within their scope
}

model Court {
  id      String      @id @default(uuid())
  venueId String
  name    String
  status  CourtStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Relations
  bookings  CourtBooking[]
  schedules CourtSchedule[]

  // Target of the composite (courtId, venueId) FK on bookings and schedules,
  // so a row cannot name a court in one venue and a different venue.
  @@unique([id, venueId])
  @@index([venueId])
  @@index([venueId, status])
}

enum CourtStatus {
  ACTIVE // Available for booking
  MAINTENANCE // Temporarily unavailable
  INACTIVE // Permanently unavailable
}

model CourtBooking {
  id          String    @id @default(uuid())
  venueId     String
  courtId     String
  userEmail   String
  userId      String?
  bookDate    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  isActive    Boolean?
  referenceId String    @unique
  isOpenPlay  Boolean
  totalPrice  Decimal?  @db.Decimal(10, 2)
  isPaid      Boolean   @default(false)

  // Open Play (all null/false while isOpenPlay = false). App-enforced
  // invariant: isOpenPlay = true <=> openPlayCapacity and openPlayJoinToken
  // are both set; isOpenPlayPublic = true => isOpenPlay = true.
  openPlayCapacity  Int? // total seats including the booker's
  isOpenPlayPublic  Boolean @default(false) // listed on the discovery endpoint
  openPlayJoinToken String? @unique // 32-char base64url capability token

  // Composite (courtId, venueId) FK: the booking's venue must be the court's
  // venue. Restrict, so deleting a court, its venue, or its tenant with
  // bookings fails instead of silently removing booking history.
  court         Court          @relation(fields: [courtId, venueId], references: [id, venueId], onDelete: Restrict)
  // Nullable and SetNull: keep the booking when its user is deleted.
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  openPlaySeats OpenPlaySeat[]

  @@index([courtId, venueId])
  @@index([userEmail])
  @@index([userId])
  @@index([isActive])
  @@index([isOpenPlay, isOpenPlayPublic, isActive, bookDate])
  @@index([venueId, bookDate]) // venue-filtered discovery; the existing index is courtId-leading
}

// One confirmed roster seat on an Open Play booking. Leaving deletes the
// row, so @@unique([bookingId, userId]) means "one active seat per user".
// References the booking only (not Court/Venue), so the composite
// (courtId, venueId) FK pattern does not apply here.
model OpenPlaySeat {
  id        String   @id @default(uuid())
  bookingId String
  userId    String
  isBooker  Boolean  @default(false) // true only for the original booker's seat
  createdAt DateTime @default(now())

  booking CourtBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([userId])
}

model CourtSchedule {
  id             String    @id @default(uuid())
  courtId        String
  venueId        String
  userEmail      String
  userId         String
  bookedDate     DateTime
  isVacant       Boolean
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  isActive       Boolean?
  hoursBooked    Int
  dateTimeVacant DateTime
  referenceId    String

  // Composite (courtId, venueId) FK: the schedule's venue must be the court's venue.
  court Court @relation(fields: [courtId, venueId], references: [id, venueId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courtId, venueId])
  @@index([userEmail])
  @@index([userId])
  @@index([isVacant])
  @@index([referenceId])
}
