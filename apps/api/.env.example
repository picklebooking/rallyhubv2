# NestJS API environment example
# Copy to apps/api/.env for local backend development.

NODE_ENV=development
PORT=3001

# Prisma database connection string.
# For direct local API development from your host machine, use localhost and the exposed Docker port 5433.
# Inside Docker Compose, the API receives a DATABASE_URL that uses postgres:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rallyhub?schema=public"

# Comma-separated list of allowed browser origins for CORS when enabled.
CORS_ORIGIN=http://localhost:3000

# API rate limiting. Defaults are 100 requests per 60 seconds, then a 60 second block.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_DURATION_MS=60000

# Stricter limits. Better Auth sign-in and sign-up: 5 attempts per 60 seconds
# per client IP (on in every environment). Tenant create, status and delete:
# 5 requests per 60 seconds per signed-in user. Limits live in memory per
# API instance.
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
TENANT_ADMIN_RATE_LIMIT_MAX=5
TENANT_ADMIN_RATE_LIMIT_TTL_MS=60000

# Proxy hops Express trusts for the client IP in x-forwarded-for (default 1,
# for Vercel, which overwrites that header with the real client address).
# Trusting x-forwarded-for is only safe behind a proxy that overwrites it:
# set 0 when the API is reachable directly, or clients can spoof their IP and
# dodge per-IP limits. Better Auth always reads a single-value
# x-forwarded-for for its sign-in limit.
TRUST_PROXY_HOPS=1

# Better Auth settings. Keep the secret backend-only and generate a long random value.
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth credentials (required). Keep both backend-only.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Local-dev-only auth bypass. Leave unset. When set to the email of an
# account you've already signed up locally, every request is treated as
# logged in as that user and no route needs @AllowAnonymous() while you
# build it. AppModule refuses to boot with this set if NODE_ENV=production.
# AUTH_DEV_BYPASS_EMAIL=you@example.com

# Optional: disposable local Postgres for DB-backed Jest suites (integration
# and HTTP authorization tests). They are skipped when unset. Jest does not
# read this file, so export it in your shell before running tests.
# TEST_DATABASE_URL="postgresql://<user>@localhost:5432/rallyhub_test"
