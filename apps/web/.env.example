# Next.js frontend environment example
# Copy to apps/web/.env.local for local frontend development.

# Browser API requests are proxied through the Next.js app, keeping auth cookies same-origin.
NEXT_PUBLIC_API_URL=/api/backend

# Server-only API origin used by Server Components. Set this to the API's Vercel URL in production.
API_INTERNAL_URL=http://localhost:3001

# Optional: disable Next telemetry locally/inside containers.
NEXT_TELEMETRY_DISABLED=1
